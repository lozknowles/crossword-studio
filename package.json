    "hero": "tsx scripts/build-hero.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.46.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18"
